# Copy to .env and fill in. Never commit .env.
# OpenAI API key (or your provider's; the address is "base_url" in project.json, the model name is "model" in workers/*/worker.json)
LLM_API_KEY=
# Mail (SMTP). 587 = STARTTLS, 465 = SSL
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 1: the mail goes to OFFICE_EMAIL and the subject starts with [リンク要約・テスト]. 0: it goes to MAIL_TO
MAIL_TEST_MODE=1
OFFICE_EMAIL=
# Real recipients (comma separated), used when MAIL_TEST_MODE=0
MAIL_TO=
