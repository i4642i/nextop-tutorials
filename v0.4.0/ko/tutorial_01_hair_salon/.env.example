# Copy to .env and fill in. Never commit .env.
# OpenAI API key (or your provider's; the address is "base_url" in project.json, the model name is "model" in workers/*/worker.json)
LLM_API_KEY=
# SMS: outbox (writes outbox/sms_<time>.txt, the default) or solapi (needs the three SOLAPI_ keys)
SMS_MODE=outbox
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SOLAPI_SENDER=01000000000
# Mail to designers (SMTP). 587 = STARTTLS, 465 = SSL
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 1: every designer mail goes to OFFICE_EMAIL (testing). 0: to the designer's own address in salon.json
MAIL_TEST_MODE=1
OFFICE_EMAIL=
# Secret that signs the approve / decline links in the designer mail: any long random text, keep it private
APPROVE_SECRET=
# Address of the chat server as the designer's phone reaches it (the links in the mail start with this)
PUBLIC_URL=http://127.0.0.1:8771
