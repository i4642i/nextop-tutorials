# .env にコピーして記入してください。.env は絶対にコミットしないでください。
# OpenAI API key (or your provider's; the address is "base_url" in project.json, the model name is "model" in workers/*/worker.json)
LLM_API_KEY=
# SMS: outbox（outbox/sms_<時刻>.txt に書き出す、既定）、twilio（TWILIO_ の3項目が必要）、
# jp_sms（国内SMSサービス用の空きスロット。functions/_notify.py の sms_jp_sms を先に書いてください）
SMS_MODE=outbox
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550100000
# スタイリストへのメール（SMTP）。587 = STARTTLS、465 = SSL
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 1: スタイリスト宛てのメールをすべて OFFICE_EMAIL に送る（テスト）。0: salon.json の各スタイリストのアドレスに送る
MAIL_TEST_MODE=1
OFFICE_EMAIL=
# メールの承認・お断りリンクに署名する秘密の文字列: 長いランダムな文字列にし、他人に見せないでください
APPROVE_SECRET=
# スタイリストのスマートフォンから見たチャットサーバーのアドレス（メールのリンクはここから始まります）
PUBLIC_URL=http://127.0.0.1:8771
